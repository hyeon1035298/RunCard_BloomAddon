              }
            },
            {
              "value": "light",
              "name": {
                "ko": "라이트",
                "en": "Light",
                "ja": "ライト",
                "zh": "浅色"
              }
            }
          ],
          "name": {
            "ko": "테마",
            "en": "Theme",
            "ja": "テーマ",
            "zh": "主题"
          },
          "about": {
            "ko": "카드의 라이트·다크입니다. Bloom 애드온으로 쓰면 Bloom의 테마를 따릅니다",
